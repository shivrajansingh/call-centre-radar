# ==================== Analysis LLM (text-only, used by the pipeline) ====================
# Any OpenAI-compatible chat endpoint. Full endpoint or base URL both work.
OPENAI_URL=https://your-gateway/v1/chat/completions
OPENAI_API_KEY=sk-...
OPENAI_MODEL=your-model-name

# ==================== Speech-to-text (STT) provider ====================
# local : mlx-whisper (whisper-large-v3-turbo, 4-bit) on Apple Silicon — free,
#         offline, no keys. Default. (~3.4x realtime)
# api   : hosted OpenAI-compatible /audio/transcriptions endpoint (OpenRouter,
#         OpenAI, Groq, ...). Costs a fraction of a cent per call.
STT_PROVIDER=local

# --- only used when STT_PROVIDER=api ---
TRANSCRIPTION_BASE_URL=https://openrouter.ai/api/v1
TRANSCRIPTION_API_KEY=sk-or-...
TRANSCRIPTION_MODEL=nvidia/nemotron-3.5-asr-streaming-multilingual-0.6b
# TRANSCRIPTION_MODEL=openai/whisper-1          # OpenAI-compatible alternative
TRANSCRIPTION_LANGUAGE=en

# ==================== Optional ====================
# HF_TOKEN=hf_...        # speeds up the mlx-whisper model download
# AUTH_SECRET=...        # signs API session tokens (change from the default!)
# RADAR_DB_URL=postgresql://radar:radar@localhost:5432/radar